# ProxDeploy environment variables
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# IMPORTANT: systemd reads this file directly (EnvironmentFile=), which is NOT
# a shell. That means:
#   - no quotes around values
#   - no spaces around '='
#   - no inline comments on a value line
#
# .env is listed in .gitignore. Never commit it — it holds your Cloudflare
# token, your API key, and your GitHub token.

# ── Flask ─────────────────────────────────────────────────────────────────────
# Signs the dashboard's session cookies. Generate one with:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# ── Domains ───────────────────────────────────────────────────────────────────
# DOMAIN is the default domain. Sites deployed to it keep bare names ("blog"),
# and that bare name is the key used in config.json, the nginx filename, and the
# log filename. Do not change this on an installation that already has sites.
DOMAIN=example.com

# Every domain ProxDeploy can deploy to, as comma-separated domain:zone_id
# pairs. Find a Zone ID at: Cloudflare dashboard -> <domain> -> Overview ->
# right sidebar. Sites on a non-default domain are keyed by full hostname
# ("blog.example.org"), so a name can never collide across two domains.
#
# Single domain is fine — just list the one:
#     DOMAINS=example.com:0123456789abcdef0123456789abcdef
DOMAINS=example.com:REPLACE_WITH_ZONE_ID,example.org:REPLACE_WITH_ZONE_ID

# ONE Cloudflare API token covering every zone listed above. Create it with the
# "Edit zone DNS" template and set Zone Resources to include each domain.
CF_API_TOKEN=your-cloudflare-api-token-here

# Kept for backwards compatibility — the zone for DOMAIN. DOMAINS takes
# precedence when it lists the same domain, so you can leave this blank.
CF_ZONE_ID=

# Cloudflare Tunnel UUID. Required ONLY to deploy a DOMAIN ROOT (landing page):
# an apex record can't CNAME to itself, so it points at
# <uuid>.cfargotunnel.com instead. Find it with:  cloudflared tunnel list
CF_TUNNEL_ID=

# A domain that lives in a DIFFERENT Cloudflare account needs its own token and
# its own tunnel (a tunnel only routes zones in its own account). Name the
# variables after the domain, dots and hyphens become underscores, uppercase:
#     DOMAIN_EXAMPLE_NET_TOKEN=token-from-the-other-account
#     DOMAIN_EXAMPLE_NET_TUNNEL=uuid-of-a-tunnel-in-the-other-account
# Leave both out for domains in your main account.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the dashboard listens on, and the address it binds. Keep BIND on
# 127.0.0.1: cloudflared reaches it on localhost, and nothing else should.
PORT=2096
BIND=127.0.0.1

# What the dashboard calls this machine.
LOCAL_LABEL=This Pi

# ── Access ────────────────────────────────────────────────────────────────────
# The dashboard password is NOT set here. setup.sh asks for it and stores a
# bcrypt hash in config.json. Change it with:  ./setup.sh --password
#
# Key used by the `proxdeploy` CLI, sent as the X-API-Key header. Leave blank to
# disable API-key auth entirely (browser session login only). Generate with:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# GitHub Personal Access Token — only needed to deploy/update PRIVATE repos.
# Scope: `repo` (classic) or Contents:read (fine-grained). Leave blank for
# public repos only. The token is redacted from log files automatically.
GITHUB_TOKEN=

# ── Public status feed ────────────────────────────────────────────────────────
# Comma-separated site keys allowed to appear on the unauthenticated
# GET /api/public/status endpoint. Empty (the default) makes that endpoint
# return 404, so the full service list can never be probed. Opt-in per site.
PUBLIC_STATUS=
