[Unit]
Description=ProxDeploy — Homelab Deploy Dashboard
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/proxdeploy
EnvironmentFile=/home/pi/proxdeploy/.env
ExecStart=/home/pi/proxdeploy/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
